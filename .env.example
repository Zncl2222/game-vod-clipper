# Optional: copy to .env before running docker compose. Do not put tokens here.
BOSSCUT_PORT=8000
BOSSCUT_BIND_ADDRESS=127.0.0.1

# For a trusted LAN, set a host interface address and list its IP/hostname here.
# This single-user application has no access-control login for visitors.
BOSSCUT_ALLOWED_HOSTS=

# Empty values use Docker-managed named volumes. To use host folders, set
# absolute paths (or ./relative-paths) and create them before starting Compose.
# The container user must be able to write them. On Linux, match id -u / id -g.
BOSSCUT_UID=1000
BOSSCUT_GID=1000
BOSSCUT_DOWNLOADS_DIR=
BOSSCUT_CLIPS_DIR=
BOSSCUT_RUNS_DIR=
BOSSCUT_CODEX_DIR=
